# Vercel production environment

# Neon pooled connection string for the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-west-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.eu-west-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

NEXTAUTH_URL="https://your-project.vercel.app"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

OWNER_ADMIN_EMAILS="nexostudiosltd@gmail.com,ridneygbs@gmail.com"

# Verified sender for transactional email
EMAIL_FROM="Nexo Tattoo <no-reply@yourdomain.com>"

# Resend SMTP example
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD="re_xxxxxxxxxxxxxxxxx"