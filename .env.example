# Google OAuth for owner admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed owner emails
OWNER_ADMIN_EMAILS=nexostudiosltd@gmail.com

# NextAuth v4 required values
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional backward-compatible aliases (if already used)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
