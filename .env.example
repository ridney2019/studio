# Comma-separated list of allowed owner emails
OWNER_ADMIN_EMAILS=nexostudiosltd@gmail.com,ridneygbs@gmail.com

# Postgres connection string. Use a local or hosted Postgres database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studio?schema=public"

# Optional direct connection for Prisma migrations. Recommended for Neon/Vercel production.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studio?schema=public"

# Sender used for verification/reset emails
EMAIL_FROM="Nexo Tattoo <no-reply@example.com>"

# SMTP transport for production email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# NextAuth v4 required values
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional backward-compatible aliases (if already used)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
